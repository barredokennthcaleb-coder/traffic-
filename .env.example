#--------------------------------------------------------------------
# Environment Configuration template.
#
# Copy this file to `.env` and adjust the values. NEVER commit the real
# `.env` — it holds credentials and machine-specific settings.
#--------------------------------------------------------------------

#--------------------------------------------------------------------
# ENVIRONMENT
#--------------------------------------------------------------------

CI_ENVIRONMENT = development

#--------------------------------------------------------------------
# APP
#--------------------------------------------------------------------

# Primary base URL (must be a valid full URL, WITH a trailing slash)
app.baseURL = 'http://localhost:8080/'
app.indexPage = ''

# Alternate hostnames/IPs that generated URLs may use (LAN / phone access)
app.allowedHostnames = localhost,127.0.0.1

# If you have trouble with `.`, you could also use `_`.
# app_baseURL = ''
# app.forceGlobalSecureRequests = false
# app.CSPEnabled = false

# --------------------------------------------------------------------
# DEFAULT ACCOUNTS / DEFAULT PASSWORDS (DEV ONLY)
# --------------------------------------------------------------------
# NOTE: Storing plaintext passwords in .env is insecure. Use only for local/dev.

auth.defaultAdminUsername = ''
auth.defaultAdminPassword = ''
auth.defaultUserPassword = ''

#--------------------------------------------------------------------
# DATABASE
#--------------------------------------------------------------------

database.default.hostname = localhost
database.default.database = database
database.default.username = root
database.default.password =
database.default.DBDriver = MySQLi
database.default.DBPrefix =
database.default.port = 3306

#--------------------------------------------------------------------
# ENCRYPTION
#--------------------------------------------------------------------
# Generate a key with: php spark key:generate
# encryption.key =

#--------------------------------------------------------------------
# SESSION
#--------------------------------------------------------------------

# session.driver = 'CodeIgniter\Session\Handlers\FileHandler'
# session.savePath = null

#--------------------------------------------------------------------
# LOGGER
#--------------------------------------------------------------------

# logger.threshold = 4

#--------------------------------------------------------------------
# POSTHOG (optional analytics; leave the key blank to disable)
#--------------------------------------------------------------------

# posthog.apiKey =
# posthog.apiHost =
