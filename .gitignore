# CodeIgniter 4 gitignore
.env
.env.*
!.env.example

# Writable directory
writable/cache/*
!writable/cache/index.html
!writable/cache/.gitkeep
writable/debugbar/*
!writable/debugbar/index.html
!writable/debugbar/.gitkeep
writable/logs/*
!writable/logs/index.html
!writable/logs/.gitkeep
writable/session/*
!writable/session/index.html
!writable/session/.gitkeep
writable/uploads/*
!writable/uploads/index.html
!writable/uploads/.gitkeep

# Public user uploads
public/uploads/*
!public/uploads/.gitkeep
public/uploads/profile/*
!public/uploads/profile/.gitkeep

# Composer & Node
/vendor/
node_modules/

# IDE & OS files
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db
/scratch/

# Generated / regenerated at will, never hand-edited
build/
screenshots/
mockups/
.freebuff/
_ide_helper.php
writable/backups/
*.bak

# Local tool data and database backups must never be committed
.appdata/
.localappdata/
writable/_db_backup_*/
*.ibd
*.frm

# Stray artifacts: local database dumps, page previews, screenshots
database.sql
preview_report.html
/screenshot_*.png
vibe_images/
writable/*.png
writable/*.pdf
