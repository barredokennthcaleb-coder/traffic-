# Disable directory browsing
<IfModule mod_autoindex.c>
    Options -Indexes
</IfModule>

# ----------------------------------------------------------------------
# Rewrite engine
# ----------------------------------------------------------------------
<IfModule mod_rewrite.c>
    Options -MultiViews
    RewriteEngine On

    # Stop rewriting if physical file or directory exists on disk
    RewriteCond %{REQUEST_URI} ^/traffic-/public/(.*)$
    RewriteCond %{DOCUMENT_ROOT}/traffic-/public/%1 -f [OR]
    RewriteCond %{DOCUMENT_ROOT}/traffic-/public/%1 -d
    RewriteRule ^ - [L]

    # Stop rewriting if already targeting index.php
    RewriteRule ^index\.php$ - [L]

    # Send all non-existing requests to index.php
    RewriteRule ^ index.php [L,QSA]
</IfModule>

<IfModule !mod_rewrite.c>
    ErrorDocument 404 index.php
</IfModule>

ServerSignature Off
