# Disable directory browsing
<IfModule mod_autoindex.c>
    Options -Indexes
</IfModule>

# ----------------------------------------------------------------------
# Rewrite engine
# ----------------------------------------------------------------------
<IfModule mod_rewrite.c>
    Options -MultiViews
    RewriteEngine On

    # Stop rewriting if the request maps to a real file or directory.
    # %{REQUEST_FILENAME} works whether the app is served from the domain
    # root (Render/Docker) or from a /traffic-/public/ subdirectory (XAMPP).
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Stop rewriting if already targeting index.php
    RewriteRule ^index\.php$ - [L]

    # Send all non-existing requests to index.php
    RewriteRule ^ index.php [L,QSA]
</IfModule>

<IfModule !mod_rewrite.c>
    ErrorDocument 404 index.php
</IfModule>

ServerSignature Off
