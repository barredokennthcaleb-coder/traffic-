# ---------------------------------------------------------------------------
# Safety net for the project root.
#
# The web server must point at public/ (the vhost does). This file only
# matters if someone ever points a document root at the folder itself: it then
# refuses to serve secrets, application code and writable runtime files.
# ---------------------------------------------------------------------------

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(\.env(\..*)?|\.git|app|system|tests|vendor|writable|composer\.(json|lock)|database\.sql|spark|phpunit\.xml\.dist)(/|$) - [F,L]
</IfModule>

<FilesMatch "^(\.env.*|composer\.(json|lock)|database\.sql|.*\.(sql|log|bak|ini|zip))$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

Options -Indexes
